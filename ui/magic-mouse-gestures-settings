#!/usr/bin/python3
"""Settings UI for magic-mouse-gestures (GTK4 + libadwaita).

Edits ~/.config/magic-mouse-gestures/config.toml. The daemon watches the file
and reloads on every save, so changes apply immediately.
"""
import os
import subprocess
import sys
import tomllib
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.magicmouse.Gestures"
SERVICE = "magic-mouse-gestures.service"

CONFIG_PATH = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "magic-mouse-gestures" / "config.toml"

DEFAULTS = {
    "general": {"device_match": "Magic Mouse", "suppress_scroll_from_fingers": 2},
    "workspace_swipe": {
        "enabled": True,
        "fingers": 2,
        "direction": "natural",
        "sensitivity": 0.4,
        "synthetic_fingers": 4,
        "activation_mm": 2.0,
        "axis": "horizontal",
        # compositor_natural_scroll absent = auto
    },
    "pinch": {"enabled": True, "fingers": 2, "sensitivity": 1.5, "activation_mm": 3.0},
    "taps": {"tap_max_ms": 300, "tap_max_mm": 4.0, "double_tap_ms": 400},
    "gesture": [
        {"kind": "double_tap", "fingers": 2, "enabled": True, "action": {"type": "key", "combo": "super+w"}},
    ],
}

KINDS = [("swipe", "Swipe"), ("tap", "Tap"), ("double_tap", "Double tap")]
DIRS = [("left", "Left"), ("right", "Right"), ("up", "Up"), ("down", "Down")]
ACTIONS = [("key", "Keyboard shortcut"), ("button", "Mouse button"), ("command", "Run command")]
ACTION_HINT = {
    "key": "e.g. super+w, ctrl+alt+right, super",
    "button": "left, right or middle",
    "command": "shell command, e.g. notify-send hi",
}


# ---------------------------------------------------------------------------
# TOML I/O (hand-rolled writer; tomllib has no dumper)
# ---------------------------------------------------------------------------

def load_config() -> dict:
    cfg = {k: (dict(v) if isinstance(v, dict) else [dict(g) for g in v]) for k, v in DEFAULTS.items()}
    try:
        with open(CONFIG_PATH, "rb") as f:
            data = tomllib.load(f)
    except FileNotFoundError:
        return cfg
    for section in ("general", "workspace_swipe", "pinch", "taps"):
        if isinstance(data.get(section), dict):
            cfg[section].update(data[section])
    if isinstance(data.get("gesture"), list):
        cfg["gesture"] = [dict(g) for g in data["gesture"]]
    return cfg


def _toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v) if isinstance(v, float) else str(v)
    s = str(v).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{s}"'


def dump_config(cfg: dict) -> str:
    out = [
        "# magic-mouse-gestures configuration",
        "# Edit by hand or with `magic-mouse-gestures-settings`. The daemon reloads on save.",
        "",
    ]
    for section in ("general", "workspace_swipe", "pinch", "taps"):
        out.append(f"[{section}]")
        for k, v in cfg[section].items():
            if v is None:
                continue
            out.append(f"{k} = {_toml_value(v)}")
        out.append("")
    for g in cfg["gesture"]:
        out.append("[[gesture]]")
        out.append(f"kind = {_toml_value(g['kind'])}")
        out.append(f"fingers = {int(g['fingers'])}")
        if g["kind"] == "swipe" and g.get("direction"):
            out.append(f"direction = {_toml_value(g['direction'])}")
        if g.get("app"):
            out.append(f"app = {_toml_value(g['app'])}")
        out.append(f"enabled = {_toml_value(bool(g.get('enabled', True)))}")
        out.append("")
        out.append("[gesture.action]")
        for k, v in g["action"].items():
            out.append(f"{k} = {_toml_value(v)}")
        out.append("")
    return "\n".join(out)


def save_config(cfg: dict) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_PATH.with_suffix(".toml.tmp")
    tmp.write_text(dump_config(cfg))
    tmp.replace(CONFIG_PATH)


def describe_action(a: dict) -> str:
    t = a.get("type")
    if t == "key":
        return f"Shortcut: {a.get('combo', '')}"
    if t == "button":
        return f"Click: {a.get('button', '')}"
    if t == "command":
        return f"Run: {a.get('command', '')}"
    return str(a)


def describe_gesture(g: dict) -> str:
    kind = dict(KINDS).get(g["kind"], g["kind"])
    n = int(g["fingers"])
    s = f"{kind} · {n} finger{'s' if n != 1 else ''}"
    if g["kind"] == "swipe" and g.get("direction"):
        s += f" · {g['direction']}"
    if g.get("app"):
        s += f" · only in {g['app']}"
    return s


def service_status() -> tuple[str, bool]:
    try:
        r = subprocess.run(["systemctl", "--user", "is-active", SERVICE], capture_output=True, text=True, timeout=3)
        state = r.stdout.strip() or "unknown"
    except Exception:
        state = "unknown"
    return state, state == "active"


# ---------------------------------------------------------------------------
# Widgets
# ---------------------------------------------------------------------------

def combo_row(title, subtitle, options, current, on_change):
    row = Adw.ComboRow(title=title, subtitle=subtitle or "")
    model = Gtk.StringList.new([label for _, label in options])
    row.set_model(model)
    keys = [k for k, _ in options]
    row.set_selected(keys.index(current) if current in keys else 0)
    row.connect("notify::selected", lambda r, _p: on_change(keys[r.get_selected()]))
    return row


def spin_row(title, subtitle, value, lo, hi, step, digits, on_change):
    adj = Gtk.Adjustment(value=value, lower=lo, upper=hi, step_increment=step, page_increment=step * 10)
    row = Adw.SpinRow(title=title, subtitle=subtitle or "", adjustment=adj, digits=digits)
    row.connect("notify::value", lambda r, _p: on_change(round(r.get_value(), digits) if digits else int(r.get_value())))
    return row


def switch_row(title, subtitle, value, on_change):
    row = Adw.SwitchRow(title=title, subtitle=subtitle or "")
    row.set_active(bool(value))
    row.connect("notify::active", lambda r, _p: on_change(r.get_active()))
    return row


class GestureDialog(Adw.Dialog):
    """Add or edit one discrete gesture rule."""

    def __init__(self, gesture: dict | None, on_done):
        super().__init__(title="Gesture", content_width=420)
        self.g = dict(gesture) if gesture else {"kind": "tap", "fingers": 3, "enabled": True, "action": {"type": "key", "combo": ""}}
        self.g["action"] = dict(self.g["action"])
        self.on_done = on_done

        tb = Adw.ToolbarView()
        header = Adw.HeaderBar()
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        save = Gtk.Button(label="Save", css_classes=["suggested-action"])
        save.connect("clicked", self._save)
        header.pack_start(cancel)
        header.pack_end(save)
        header.set_show_end_title_buttons(False)
        header.set_show_start_title_buttons(False)
        tb.add_top_bar(header)

        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup(title="Trigger")
        grp.add(combo_row("Type", None, KINDS, self.g["kind"], self._set_kind))
        grp.add(spin_row("Fingers", None, int(self.g["fingers"]), 1, 5, 1, 0, lambda v: self.g.__setitem__("fingers", v)))
        self.dir_row = combo_row("Direction", "Only for swipes", DIRS, self.g.get("direction") or "left",
                                 lambda v: self.g.__setitem__("direction", v))
        self.dir_row.set_visible(self.g["kind"] == "swipe")
        grp.add(self.dir_row)
        page.add(grp)

        grp = Adw.PreferencesGroup(title="Action")
        grp.add(combo_row("Do", None, ACTIONS, self.g["action"]["type"], self._set_action_type))
        self.value_row = Adw.EntryRow(title=ACTION_HINT[self.g["action"]["type"]])
        self.value_row.set_text(self._action_value())
        grp.add(self.value_row)
        page.add(grp)

        grp = Adw.PreferencesGroup(title="Scope",
                                   description="Leave empty for every app. Otherwise the rule only fires when the focused window's app id contains this text (e.g. firefox). Needs COSMIC, KDE, Sway or Hyprland.")
        self.app_row = Adw.EntryRow(title="Only in app")
        self.app_row.set_text(self.g.get("app") or "")
        grp.add(self.app_row)
        page.add(grp)
        tb.set_content(page)
        self.set_child(tb)

    def _action_value(self):
        a = self.g["action"]
        return a.get("combo") or a.get("button") or a.get("command") or ""

    def _set_kind(self, k):
        self.g["kind"] = k
        self.dir_row.set_visible(k == "swipe")
        if k == "swipe" and not self.g.get("direction"):
            self.g["direction"] = "left"

    def _set_action_type(self, t):
        self.g["action"] = {"type": t}
        self.value_row.set_title(ACTION_HINT[t])

    def _save(self, *_):
        t = self.g["action"]["type"]
        key = {"key": "combo", "button": "button", "command": "command"}[t]
        value = self.value_row.get_text().strip()
        if not value:
            self.value_row.add_css_class("error")
            return
        self.g["action"] = {"type": t, key: value}
        if self.g["kind"] != "swipe":
            self.g.pop("direction", None)
        app = self.app_row.get_text().strip()
        if app:
            self.g["app"] = app
        else:
            self.g.pop("app", None)
        self.on_done(self.g)
        self.close()


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Magic Mouse Gestures", default_width=560, default_height=720)
        self.cfg = load_config()
        self._save_id = 0

        tb = Adw.ToolbarView()
        tb.add_top_bar(Adw.HeaderBar())
        self.toast = Adw.ToastOverlay()
        page = Adw.PreferencesPage()
        self.toast.set_child(page)
        tb.set_content(self.toast)
        self.set_content(tb)

        ws = self.cfg["workspace_swipe"]
        grp = Adw.PreferencesGroup(title="Workspace swipe",
                                   description="Continuous swipe that follows your fingers using the desktop's native animation.")
        grp.add(switch_row("Enabled", None, ws["enabled"], lambda v: self._set("workspace_swipe", "enabled", v)))
        grp.add(spin_row("Fingers on the mouse", None, ws["fingers"], 1, 4, 1, 0, lambda v: self._set("workspace_swipe", "fingers", v)))
        grp.add(combo_row("Direction", "Natural: swipe left to go to the next workspace (macOS style)",
                          [("natural", "Natural"), ("inverted", "Inverted")], ws["direction"],
                          lambda v: self._set("workspace_swipe", "direction", v)))
        grp.add(spin_row("Sensitivity", "Higher = less finger travel per workspace", ws["sensitivity"], 0.05, 3.0, 0.05, 2,
                         lambda v: self._set("workspace_swipe", "sensitivity", v)))
        grp.add(spin_row("Activation distance (mm)", "Finger travel before a swipe starts", ws["activation_mm"], 0.5, 15.0, 0.5, 1,
                         lambda v: self._set("workspace_swipe", "activation_mm", v)))
        grp.add(combo_row("Desktop gesture fingers", "Fingers the desktop expects for a workspace swipe: 4 for COSMIC, 3 for GNOME",
                          [("4", "4 (COSMIC, KDE)"), ("3", "3 (GNOME)")], str(ws["synthetic_fingers"]),
                          lambda v: self._set("workspace_swipe", "synthetic_fingers", int(v))))
        grp.add(combo_row("Axis", "Direction your desktop arranges workspaces in. Both: lock to the first direction and let the desktop decide (GNOME: vertical = overview)",
                          [("horizontal", "Horizontal"), ("vertical", "Vertical"), ("both", "Both")], ws["axis"],
                          lambda v: self._set("workspace_swipe", "axis", v)))
        cns = ws.get("compositor_natural_scroll")
        grp.add(combo_row("Desktop touchpad natural scrolling", "Leave on Auto unless the swipe goes the wrong way",
                          [("auto", "Auto-detect"), ("true", "On"), ("false", "Off")],
                          "auto" if cns is None else str(cns).lower(),
                          lambda v: self._set("workspace_swipe", "compositor_natural_scroll", None if v == "auto" else v == "true")))
        page.add(grp)

        pz = self.cfg["pinch"]
        grp = Adw.PreferencesGroup(title="Pinch zoom", description="Two fingers moving apart or together become the desktop's native pinch gesture.")
        grp.add(switch_row("Enabled", None, pz["enabled"], lambda v: self._set("pinch", "enabled", v)))
        grp.add(spin_row("Sensitivity", "1.0 = same zoom as a touchpad", pz["sensitivity"], 0.2, 4.0, 0.1, 1,
                         lambda v: self._set("pinch", "sensitivity", v)))
        grp.add(spin_row("Activation distance (mm)", "Change in finger distance before a pinch starts", pz["activation_mm"], 0.5, 15.0, 0.5, 1,
                         lambda v: self._set("pinch", "activation_mm", v)))
        page.add(grp)

        self.gest_group = Adw.PreferencesGroup(title="Gestures", description="Taps and quick swipes that trigger an action once, optionally only in one app.")
        add = Gtk.Button(icon_name="list-add-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"])
        add.connect("clicked", lambda *_: self._edit_gesture(None))
        self.gest_group.set_header_suffix(add)
        self.gest_rows = []
        self._rebuild_gestures()
        page.add(self.gest_group)

        taps = self.cfg["taps"]
        grp = Adw.PreferencesGroup(title="Tap timing")
        grp.add(spin_row("Tap max duration (ms)", None, taps["tap_max_ms"], 50, 1000, 10, 0, lambda v: self._set("taps", "tap_max_ms", v)))
        grp.add(spin_row("Tap max movement (mm)", None, taps["tap_max_mm"], 0.5, 20, 0.5, 1, lambda v: self._set("taps", "tap_max_mm", v)))
        grp.add(spin_row("Double tap window (ms)", None, taps["double_tap_ms"], 100, 1000, 10, 0, lambda v: self._set("taps", "double_tap_ms", v)))
        page.add(grp)

        gen = self.cfg["general"]
        grp = Adw.PreferencesGroup(title="Advanced")
        grp.add(spin_row("Mute scrolling from N fingers", "Drop the driver's scroll-wheel emulation while this many fingers touch (0 = never)",
                         gen["suppress_scroll_from_fingers"], 0, 5, 1, 0, lambda v: self._set("general", "suppress_scroll_from_fingers", v)))
        dm = Adw.EntryRow(title="Device name contains")
        dm.set_text(gen["device_match"])
        dm.connect("apply", lambda r: self._set("general", "device_match", r.get_text().strip() or "Magic Mouse"))
        dm.set_show_apply_button(True)
        grp.add(dm)
        page.add(grp)

        grp = Adw.PreferencesGroup(title="Daemon")
        self.status_row = Adw.ActionRow(title="Background service")
        self.status_icon = Gtk.Image.new_from_icon_name("dialog-warning-symbolic")
        self.status_row.add_prefix(self.status_icon)
        restart = Gtk.Button(label="Restart", valign=Gtk.Align.CENTER)
        restart.connect("clicked", self._restart)
        self.status_row.add_suffix(restart)
        grp.add(self.status_row)
        open_row = Adw.ActionRow(title="Config file", subtitle=str(CONFIG_PATH), activatable=True)
        open_row.add_suffix(Gtk.Image.new_from_icon_name("document-open-symbolic"))
        open_row.connect("activated", lambda *_: Gio.AppInfo.launch_default_for_uri(CONFIG_PATH.as_uri(), None))
        grp.add(open_row)
        page.add(grp)
        self._refresh_status()
        GLib.timeout_add_seconds(5, self._refresh_status)

    # -- state -----------------------------------------------------------
    def _set(self, section, key, value):
        if value is None:
            self.cfg[section].pop(key, None)
        else:
            self.cfg[section][key] = value
        self._schedule_save()

    def _schedule_save(self):
        if self._save_id:
            GLib.source_remove(self._save_id)
        self._save_id = GLib.timeout_add(400, self._do_save)

    def _do_save(self):
        self._save_id = 0
        try:
            save_config(self.cfg)
        except Exception as e:  # noqa: BLE001
            self.toast.add_toast(Adw.Toast(title=f"Could not save: {e}"))
        return False

    # -- gestures --------------------------------------------------------
    def _rebuild_gestures(self):
        for r in self.gest_rows:
            self.gest_group.remove(r)
        self.gest_rows = []
        for i, g in enumerate(self.cfg["gesture"]):
            row = Adw.ActionRow(title=describe_gesture(g), subtitle=describe_action(g["action"]), activatable=True)
            sw = Gtk.Switch(active=bool(g.get("enabled", True)), valign=Gtk.Align.CENTER)
            sw.connect("notify::active", lambda s, _p, idx=i: self._toggle_gesture(idx, s.get_active()))
            row.add_suffix(sw)
            rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, css_classes=["flat"])
            rm.connect("clicked", lambda _b, idx=i: self._remove_gesture(idx))
            row.add_suffix(rm)
            row.connect("activated", lambda _r, idx=i: self._edit_gesture(idx))
            self.gest_group.add(row)
            self.gest_rows.append(row)
        if not self.cfg["gesture"]:
            row = Adw.ActionRow(title="No gestures yet", subtitle="Use + to add one")
            self.gest_group.add(row)
            self.gest_rows.append(row)

    def _toggle_gesture(self, idx, on):
        self.cfg["gesture"][idx]["enabled"] = on
        self._schedule_save()

    def _remove_gesture(self, idx):
        del self.cfg["gesture"][idx]
        self._rebuild_gestures()
        self._schedule_save()

    def _edit_gesture(self, idx):
        existing = self.cfg["gesture"][idx] if idx is not None else None

        def done(g):
            if idx is None:
                self.cfg["gesture"].append(g)
            else:
                self.cfg["gesture"][idx] = g
            self._rebuild_gestures()
            self._schedule_save()

        GestureDialog(existing, done).present(self)

    # -- daemon ----------------------------------------------------------
    def _refresh_status(self):
        state, ok = service_status()
        self.status_row.set_subtitle(f"{SERVICE}: {state}")
        self.status_icon.set_from_icon_name("emblem-ok-symbolic" if ok else "dialog-warning-symbolic")
        return True

    def _restart(self, *_):
        subprocess.run(["systemctl", "--user", "restart", SERVICE], check=False)
        GLib.timeout_add(800, self._refresh_status)
        self.toast.add_toast(Adw.Toast(title="Service restarted"))


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        win = self.props.active_window or Window(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
