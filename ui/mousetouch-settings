def describe_gesture(ev: dict) -> str:
    name = _("Workspace swipe") if ev.get("gesture") == "workspace_swipe" else _("Pinch")
    s = f"{name} · {fingers_text(ev.get('fingers', 0))}"
    if ev.get("dir"):
        s += " " + DIR_ARROWS.get(ev["dir"], ev["dir"])
    return s


def describe_event(ev: dict) -> str | None:
    """Log line for an event, or None for the ones that are drawn only."""
    t = ev.get("t")
    if t == "rule":
        return describe_rule(ev)
    if t == "gesture_begin":
        return describe_gesture(ev)
    if t == "touch_end":
        n = ev.get("fingers", 0)
        if ev.get("tap"):
            return f"{_('Tap')} · {fingers_text(n)}"
        return f"{fingers_text(n)} · " + _("not a tap: {reason}").format(reason=_(ev.get("reason", "")))
    if t == "button":
        return f"{_('Click')}: {ev.get('button', '')} {'↓' if ev.get('down') else '↑'}"
    if t == "device":
        return _("Mouse attached: {name}").format(name=ev.get("name", ""))
    if t == "device_lost":
        return _("Mouse detached")
    if t == "connected":
        return _("Connected to the daemon")
    if t == "disconnected":
        return _("Daemon disconnected")
    return None


def draw_text(cr, text, x, y, size=11.0, color=(0, 0, 0), align="left", bold=False, alpha=1.0):
    layout = PangoCairo.create_layout(cr)
    fd = Pango.FontDescription.from_string("Sans")
    fd.set_absolute_size(size * Pango.SCALE)
    if bold:
        fd.set_weight(Pango.Weight.BOLD)
    layout.set_font_description(fd)
    layout.set_text(text, -1)
    tw, th = layout.get_pixel_size()
    if align == "center":
        x, y = x - tw / 2, y - th / 2
    elif align == "right":
        x -= tw
    cr.set_source_rgba(*color, alpha)
    cr.move_to(x, y)
    PangoCairo.show_layout(cr, layout)
    return tw, th


def rounded_rect(cr, x, y, w, h, r):
    r = min(r, w / 2, h / 2)
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def draw_arrow(cr, x1, y1, x2, y2, color, width=4.0, alpha=1.0):
    ang = math.atan2(y2 - y1, x2 - x1)
    head = max(8.0, width * 2.6)
    cr.set_source_rgba(*color, alpha)
    cr.set_line_width(width)
    cr.set_line_cap(cairo.LINE_CAP_ROUND)
    cr.move_to(x1, y1)
    cr.line_to(x2 - math.cos(ang) * head * 0.6, y2 - math.sin(ang) * head * 0.6)
    cr.stroke()
    cr.move_to(x2, y2)
    cr.line_to(x2 - head * math.cos(ang - 0.5), y2 - head * math.sin(ang - 0.5))
    cr.line_to(x2 - head * math.cos(ang + 0.5), y2 - head * math.sin(ang + 0.5))
    cr.close_path()
    cr.fill()


class MouseView(Gtk.DrawingArea):
    """Top view of the mouse with the fingers on it, where they landed, the
    path they took, the gesture the daemon is replaying, scrolling and
    clicks. Listens only while mapped."""

    BADGE_S = 2.8
    TRAIL_S = 0.7

    def __init__(self, client: EventClient, compact: bool = False):
        super().__init__(hexpand=True, vexpand=True)
        self.set_content_height(240 if compact else 340)
        self.client = client
        self.compact = compact
        self.connected = client.connected
        self.device = None
        self.fingers = []
        self.trails = {}
        self.lifted = []
        self.state = "idle"
        self.pad = None
        self.scale = None
        self.badges = []
        self.scroll = {"dx": 0.0, "dy": 0.0, "t": 0.0}
        self.buttons = {}
        self._tick = 0
        self.set_draw_func(self._draw)
        self.connect("map", lambda *_a: client.add_listener(self.on_event))
        self.connect("unmap", lambda *_a: client.remove_listener(self.on_event))

    # -- events ------------------------------------------------------------
    def on_event(self, ev: dict):
        t = ev.get("t")
        now = time.monotonic()
        if t == "connected":
            self.connected = True
        elif t == "disconnected":
            self.connected = False
            self.device = None
            self._clear_touch()
        elif t == "device":
            self.device = ev
        elif t == "device_lost":
            self.device = None
            self._clear_touch()
        elif t == "frame":
            fingers = ev.get("fingers", [])
            if fingers:
                ids = {f["id"] for f in fingers}
                for f in fingers:
                    tr = self.trails.setdefault(f["id"], [])
                    tr.append((f["x"], f["y"], now))
                    del tr[:-150]
                for k in [k for k in self.trails if k not in ids]:
                    del self.trails[k]
            else:
                self.lifted = [(f["x"], f["y"], now) for f in self.fingers] + self.lifted
                self.trails = {}
            self.fingers = fingers
            self.state = ev.get("state", "idle")
            self.pad = (ev["pad_dx"], ev["pad_dy"]) if "pad_dx" in ev else None
            self.scale = ev.get("scale")
        elif t == "gesture_begin":
            self._badge(describe_gesture(ev), "accent")
        elif t == "rule":
            # Every 1-finger movement is checked against swipe rules; a miss
            # there is just normal mouse use, not worth a badge.
            if ev.get("matched") or ev.get("fingers", 0) > 1 or ev.get("kind") != "swipe":
                self._badge(describe_rule(ev), "accent" if ev.get("matched") else "muted")
        elif t == "touch_end":
            n = ev.get("fingers", 0)
            if ev.get("tap"):
                self._badge(f"{_('Tap')} · {fingers_text(n)}", "info")
            elif n > 1 and ev.get("reason"):
                self._badge(_("not a tap: {reason}").format(reason=_(ev["reason"])), "warn")
        elif t == "scroll":
            if now - self.scroll["t"] > 0.8:
                self.scroll["dx"] = self.scroll["dy"] = 0.0
            self.scroll["dx"] += ev.get("dx", 0)
            self.scroll["dy"] += ev.get("dy", 0)
            self.scroll["t"] = now
        elif t == "button":
            self.buttons[ev.get("button", "")] = bool(ev.get("down"))
        self._animate()

    def _clear_touch(self):
        self.fingers = []
        self.trails = {}
        self.state = "idle"
        self.pad = self.scale = None
        self.buttons = {}

    def _badge(self, text: str, kind: str):
        self.badges.append({"text": text, "kind": kind, "t": time.monotonic()})
        del self.badges[:-3]

    def _animating(self, now: float) -> bool:
        return bool(self.fingers or self.lifted or self.badges or now - self.scroll["t"] < 1.0 or any(self.buttons.values()))

    def _animate(self):
        self.queue_draw()
        if not self._tick:
            self._tick = GLib.timeout_add(33, self._on_tick)

    def _on_tick(self):
        now = time.monotonic()
        self.badges = [b for b in self.badges if now - b["t"] < self.BADGE_S]
        self.lifted = [g for g in self.lifted if now - g[2] < 0.6]
        self.queue_draw()
        if self._animating(now):
            return True
        self._tick = 0
        return False

    # -- drawing -----------------------------------------------------------
    def _draw(self, _area, cr, w, h):
        dark = Adw.StyleManager.get_default().get_dark()
        fg = (0.93, 0.93, 0.93) if dark else (0.13, 0.13, 0.13)
        muted = (0.62, 0.62, 0.64) if dark else (0.47, 0.47, 0.48)
        body = (0.20, 0.20, 0.21) if dark else (0.975, 0.975, 0.97)
        edge = (0.45, 0.45, 0.47) if dark else (0.68, 0.68, 0.67)
        now = time.monotonic()
        font = 10.0 if self.compact else 11.5

        # Header: device or status; finger count.
        if not self.connected:
            title, hint = _("Daemon not running"), _("Start the background service (mousetouch.service)")
        elif not self.device:
            title, hint = _("No Magic Mouse connected"), ""
        else:
            title, hint = self.device.get("name", ""), self.device.get("source", "")
        draw_text(cr, title, 12, 8, font, fg if self.device else muted, bold=True)
        if hint:
            draw_text(cr, hint, 12, 8 + font * 1.5, font * 0.9, muted)
        if self.fingers:
            state = {"workspace": _("Workspace swipe"), "pinch": _("Pinch")}.get(self.state)
            right = fingers_text(len(self.fingers)) + (f" · {state}" if state else "")
            draw_text(cr, right, w - 12, 8, font, fg, align="right", bold=True)
        elif self.device and not self.badges:
            draw_text(cr, _("Waiting for a touch…"), w - 12, 8, font * 0.9, muted, align="right")

        # Outline, leaving room for the header and the scroll gauge.
        top = 8 + font * 3.2
        gauge = 64
        s = min((h - top - 18) / MOUSE_L_MM, (w - 2 * gauge) / MOUSE_W_MM)
        mw, ml = MOUSE_W_MM * s, MOUSE_L_MM * s
        mx, my = (w - mw) / 2, top + (h - top - 14 - ml) / 2
        rounded_rect(cr, mx, my, mw, ml, mw * 0.46)
        cr.set_source_rgb(*body)
        cr.fill_preserve()
        cr.set_source_rgb(*edge)
        cr.set_line_width(1.5)
        cr.stroke()
        if not self.device:
            cr.set_source_rgba(*muted, 0.25 if dark else 0.18)
            rounded_rect(cr, mx, my, mw, ml, mw * 0.46)
            cr.fill()

        # Clicks light up the front half on the side pressed.
        for name, down in self.buttons.items():
            if not down:
                continue
            cr.save()
            rounded_rect(cr, mx, my, mw, ml, mw * 0.46)
            cr.clip()
            if name == "left":
                cr.rectangle(mx, my, mw / 2, ml * 0.42)
            elif name == "right":
                cr.rectangle(mx + mw / 2, my, mw / 2, ml * 0.42)
            else:
                cr.rectangle(mx + mw * 0.3, my, mw * 0.4, ml * 0.42)
            cr.set_source_rgba(*ACCENT, 0.3)
            cr.fill()
            cr.restore()

        dev_w = (self.device or {}).get("w_mm") or 1.0
        dev_h = (self.device or {}).get("h_mm") or 1.0
        inset = 3.0 * s

        def to_px(x, y):
            return (
                mx + inset + (mw - 2 * inset) * min(1.0, max(0.0, x / dev_w)),
                my + inset + (ml - 2 * inset) * min(1.0, max(0.0, y / dev_h)),
            )

        r = max(8.0, 4.5 * s)  # a fingertip contact is roughly 9 mm across

        # Ghosts of fingers that just lifted.
        for x, y, t0 in self.lifted:
            a = max(0.0, 1 - (now - t0) / 0.6)
            px, py = to_px(x, y)
            cr.arc(px, py, r * (1 + 0.8 * (1 - a)), 0, 2 * math.pi)
            cr.set_source_rgba(*muted, 0.45 * a)
            cr.set_line_width(2)
            cr.stroke()

        # Trails, landing points and fingers.
        for i, f in enumerate(self.fingers):
            col = FINGER_COLORS[i % len(FINGER_COLORS)]
            tr = self.trails.get(f["id"], [])
            if len(tr) > 1:
                cr.set_line_width(max(2.0, r * 0.5))
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                for (x1, y1, _t1), (x2, y2, t2) in zip(tr, tr[1:]):
                    age = now - t2
                    if age > self.TRAIL_S:
                        continue
                    cr.move_to(*to_px(x1, y1))
                    cr.line_to(*to_px(x2, y2))
                    cr.set_source_rgba(*col, 0.5 * (1 - age / self.TRAIL_S))
                    cr.stroke()
            x0, y0 = to_px(f["x0"], f["y0"])
            px, py = to_px(f["x"], f["y"])
            if math.hypot(px - x0, py - y0) > r * 0.8:
                cr.arc(x0, y0, r * 0.4, 0, 2 * math.pi)
                cr.set_source_rgba(*col, 0.85)
                cr.set_line_width(1.5)
                cr.stroke()
            cr.arc(px, py, r, 0, 2 * math.pi)
            cr.set_source_rgba(*col, 0.95)
            cr.fill_preserve()
            cr.set_source_rgba(1, 1, 1, 0.9)
            cr.set_line_width(2)
            cr.stroke()
            draw_text(cr, str(i + 1), px, py, r * 1.15, (1, 1, 1), align="center", bold=True)

        # Centroid and the continuous gesture being replayed.
        if len(self.fingers) >= 2:
            cx = sum(f["x"] for f in self.fingers) / len(self.fingers)
            cy = sum(f["y"] for f in self.fingers) / len(self.fingers)
            pcx, pcy = to_px(cx, cy)
            cr.set_source_rgba(*fg, 0.5)
            cr.set_line_width(1.2)
            cr.move_to(pcx - 6, pcy)
            cr.line_to(pcx + 6, pcy)
            cr.move_to(pcx, pcy - 6)
            cr.line_to(pcx, pcy + 6)
            cr.stroke()
            if self.state == "workspace" and self.pad:
                dx, dy = self.pad
                dist = math.hypot(dx, dy)
                if dist > 0.3:
                    ux, uy = dx / dist, dy / dist
                    length = min(ml * 0.42, 14 + dist * s)
                    draw_arrow(cr, pcx, pcy, pcx + ux * length, pcy + uy * length, ACCENT, width=max(3.0, r * 0.4))
                    draw_text(cr, f"{dist:.0f} mm", pcx + ux * (length + 10), pcy + uy * (length + 10) - font / 2, font, fg,
                              align="right" if ux < 0 else "left", bold=True)
            elif self.state == "pinch" and self.scale:
                # One arrow beyond each finger, pointing away from the centroid
                # when the fingers spread and towards it when they close.
                out = self.scale >= 1.0
                reach = r * 2.2
                for f in self.fingers[:2]:
                    px, py = to_px(f["x"], f["y"])
                    d = math.hypot(px - pcx, py - pcy)
                    if d < 1:
                        continue
                    ux, uy = (px - pcx) / d, (py - pcy) / d
                    base = (px + ux * r * 1.3, py + uy * r * 1.3)
                    tip = (base[0] + ux * reach, base[1] + uy * reach)
                    if out:
                        draw_arrow(cr, *base, *tip, ACCENT, width=max(3.0, r * 0.3))
                    else:
                        draw_arrow(cr, *tip, *base, ACCENT, width=max(3.0, r * 0.3))
                draw_text(cr, f"×{self.scale:.2f}", pcx, pcy + r * 1.6, font, fg, align="center", bold=True)

        # Scroll gauge beside the mouse (vertical wheel) and below it (horizontal).
        age = now - self.scroll["t"]
        if age < 1.0 and (self.scroll["dy"] or self.scroll["dx"]):
            a = 1.0 if age < 0.5 else 1 - (age - 0.5) / 0.5
            gx = mx + mw + gauge * 0.55
            cr.set_source_rgba(*muted, 0.35 * a)
            cr.set_line_width(2)
            cr.move_to(gx, my + ml * 0.15)
            cr.line_to(gx, my + ml * 0.85)
            cr.stroke()
            notches = self.scroll["dy"] / 120.0
            if notches:
                # Positive wheel = away from the user = content up.
                length = min(ml * 0.33, 10 + abs(notches) * 14)
                gy = my + ml / 2
                draw_arrow(cr, gx, gy, gx, gy - math.copysign(length, notches), ACCENT, width=3.5, alpha=a)
                draw_text(cr, f"{notches:+.1f}", gx, gy + math.copysign(length + 10, -notches) - font / 2, font, fg, align="center", alpha=a, bold=True)
            hnotches = self.scroll["dx"] / 120.0
            if hnotches:
                length = min(mw * 0.4, 10 + abs(hnotches) * 14)
                gy = my + ml + 8
                draw_arrow(cr, mx + mw / 2, gy, mx + mw / 2 + math.copysign(length, hnotches), gy, ACCENT, width=3.5, alpha=a)

        # Badges: recent discrete results, newest at the bottom.
        by = h - 10
        for b in reversed(self.badges):
            age = now - b["t"]
            a = 1.0 if age < self.BADGE_S - 0.7 else max(0.0, (self.BADGE_S - age) / 0.7)
            bg = {"accent": ACCENT, "warn": (0.90, 0.45, 0.10), "muted": muted, "info": (0.36, 0.60, 0.46)}[b["kind"]]
            layout = PangoCairo.create_layout(cr)
            fd = Pango.FontDescription.from_string("Sans")
            fd.set_absolute_size(font * Pango.SCALE)
            fd.set_weight(Pango.Weight.BOLD)
            layout.set_font_description(fd)
            layout.set_text(b["text"], -1)
            layout.set_width(int((w - 24) * Pango.SCALE))
            layout.set_ellipsize(Pango.EllipsizeMode.END)
            tw, th = layout.get_pixel_size()
            bh = th + 10
            rounded_rect(cr, 10, by - bh, tw + 18, bh, bh / 2)
            cr.set_source_rgba(*bg, 0.92 * a)
            cr.fill()
            cr.set_source_rgba(1, 1, 1, a)
            cr.move_to(19, by - bh + 5)
            PangoCairo.show_layout(cr, layout)
            by -= bh + 6


class EventLog(Gtk.ScrolledWindow):
    """Newest-first list of what the daemon reported. Consecutive scroll
    events within half a second share one row."""

    MAX_ROWS = 120

    def __init__(self, client: EventClient):
        super().__init__(vexpand=True, min_content_height=150, hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, css_classes=["boxed-list"])
        self.set_child(self.list)
        self._scroll_row = None
        self._scroll_t = 0.0
        self._scroll_sum = [0.0, 0.0]
        self.connect("map", lambda *_a: client.add_listener(self.on_event))
        self.connect("unmap", lambda *_a: client.remove_listener(self.on_event))

    def on_event(self, ev: dict):
        if ev.get("t") == "scroll":
            now = time.monotonic()
            if self._scroll_row is None or now - self._scroll_t > 0.5 or self.list.get_row_at_index(0) is not self._scroll_row:
                self._scroll_sum = [0.0, 0.0]
                self._scroll_row = self._add("")
            self._scroll_t = now
            self._scroll_sum[0] += ev.get("dx", 0)
            self._scroll_sum[1] += ev.get("dy", 0)
            parts = []
            if self._scroll_sum[1]:
                parts.append(f"{'↑' if self._scroll_sum[1] > 0 else '↓'} {abs(self._scroll_sum[1]) / 120:.1f}")
            if self._scroll_sum[0]:
                parts.append(f"{'→' if self._scroll_sum[0] > 0 else '←'} {abs(self._scroll_sum[0]) / 120:.1f}")
            self._scroll_row.set_title(GLib.markup_escape_text(f"{_('Scroll')} {' '.join(parts)}"))
            return
        text = describe_event(ev)
        if text:
            self._add(text)

    def _add(self, text: str) -> Adw.ActionRow:
        row = Adw.ActionRow(title=GLib.markup_escape_text(text), subtitle=time.strftime("%H:%M:%S"))
        self.list.prepend(row)
        extra = self.list.get_row_at_index(self.MAX_ROWS)
        if extra is not None:
            self.list.remove(extra)
        return row

    def clear(self):
        while (row := self.list.get_row_at_index(0)) is not None:
            self.list.remove(row)
        self._scroll_row = None


def mousetouch_binary() -> str | None:
    exe = shutil.which("mousetouch")
    if exe:
        return exe
    here = Path(__file__).resolve().parent.parent
    for p in (here / "target" / "release" / "mousetouch", here / "target" / "debug" / "mousetouch"):
        if p.is_file() and os.access(p, os.X_OK):
            return str(p)
    return None


def set_window_sticky(title: str, on: bool) -> tuple[bool, str]:
    """Ask the compositor (through `mousetouch sticky`) to show the window
    with this title on every workspace. Returns (ok, message)."""
    exe = mousetouch_binary()
    if not exe:
        return False, _("Could not run mousetouch: {error}").format(error="mousetouch not found in PATH")
    try:
        r = subprocess.run([exe, "sticky", APP_ID, title, "on" if on else "off"], capture_output=True, text=True, timeout=5)
    except Exception as e:  # noqa: BLE001
        return False, _("Could not run mousetouch: {error}").format(error=e)
    if r.returncode == 0:
        return True, ""
    if r.returncode == 2:
        return False, _("Your desktop does not let apps pin windows. Use the window menu instead: COSMIC → Sticky, GNOME → Always on Visible Workspace, KDE → All Desktops.")
    return False, _("Could not run mousetouch: {error}").format(error=r.stderr.strip() or f"exit {r.returncode}")


class RepairDialog(Adw.Dialog):
    """Runs `mousetouch bt-repair` and shows its progress line by line. The
    daemon's helper removes the mouse from BlueZ, waits for it to advertise
    again (you switch it off and on), then pairs, trusts and connects."""

    def __init__(self, name_match: str, on_done):
        super().__init__(title=_("Forget and pair again"), content_width=420, can_close=False)
        self.on_done = on_done
        tb = Adw.ToolbarView()
        tb.add_top_bar(Adw.HeaderBar(show_end_title_buttons=False, show_start_title_buttons=False))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_start=24, margin_end=24, margin_top=12, margin_bottom=24)
        self.spinner = Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, width_request=32, height_request=32)
        box.append(self.spinner)
        self.headline = Gtk.Label(label=_("Working…"), css_classes=["title-3"], wrap=True, justify=Gtk.Justification.CENTER)
        box.append(self.headline)
        self.detail = Gtk.Label(label="", css_classes=["dim-label"], wrap=True, justify=Gtk.Justification.CENTER)
        box.append(self.detail)
        self.close_btn = Gtk.Button(label=_("Cancel"), halign=Gtk.Align.CENTER)
        self.close_btn.connect("clicked", self._cancel_or_close)
        box.append(self.close_btn)
        tb.set_content(box)
        self.set_child(tb)
        self.proc = None
        self.finished = False
        exe = mousetouch_binary()
        if not exe:
            self._finish(False, _("Could not run mousetouch: {error}").format(error="mousetouch not found in PATH"))
            return
        try:
            self.proc = Gio.Subprocess.new([exe, "bt-repair", name_match], Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
        except GLib.Error as e:
            self._finish(False, _("Could not run mousetouch: {error}").format(error=e.message))
            return
        self.out = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self.err = Gio.DataInputStream.new(self.proc.get_stderr_pipe())
        self.err_text = ""
        self.out.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line)
        self.err.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_err_line)
        self.proc.wait_async(None, self._on_exit)

    def _on_line(self, stream, result):
        try:
            line, _len = stream.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if line is None:
            return
        kind, _sep, text = line.partition(":")
        text = text.strip()
        if kind == "hint":
            self.headline.set_label(_("Switch the mouse off and on"))
        elif kind == "step":
            self.detail.set_label(text)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_line)

    def _on_err_line(self, stream, result):
        try:
            line, _len = stream.read_line_finish_utf8(result)
        except GLib.Error:
            line = None
        if line is None:
            return
        self.err_text = line.strip() or self.err_text
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._on_err_line)

    def _on_exit(self, proc, result):
        try:
            proc.wait_finish(result)
        except GLib.Error:
            pass
        ok = proc.get_if_exited() and proc.get_exit_status() == 0
        err = self.err_text.removeprefix("Error:").strip()
        self._finish(ok, "" if ok else _("Pairing failed: {error}").format(error=err or f"exit {proc.get_exit_status()}"))

    def _finish(self, ok: bool, message: str):
        self.finished = True
        self.spinner.set_spinning(False)
        self.spinner.set_visible(False)
        self.headline.set_label(_("Paired again") if ok else message)
        self.detail.set_label("")
        self.close_btn.set_label(_("Close"))
        self.close_btn.add_css_class("suggested-action")
        self.set_can_close(True)
        self.on_done(ok)

    def _cancel_or_close(self, *_a):
        if not self.finished and self.proc is not None:
            self.proc.force_exit()
        self.set_can_close(True)
        self.close()


class LiveWindow(Adw.Window):
    """The live view on its own, with the event log, so it can sit next to
    whatever you are testing. The pin button asks the compositor to keep it
    on every workspace (sticky), which COSMIC exposes a protocol for."""

    def __init__(self, app, client: EventClient):
        super().__init__(application=app, title=_("MouseTouch · Live"), default_width=460, default_height=760)
        self._pin_guard = False
        tb = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.pin = Gtk.ToggleButton(icon_name="view-pin-symbolic")
        self.pin.set_tooltip_text(f"{_('Keep on screen')} — {_('Stays visible while workspaces slide (sticky window)')}")
        header.pack_start(self.pin)
        clear = Gtk.Button(icon_name="edit-clear-all-symbolic", tooltip_text=_("Clear log"))
        header.pack_end(clear)
        tb.add_top_bar(header)
        self.toast = Adw.ToastOverlay()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_start=12, margin_end=12, margin_top=6, margin_bottom=12)
        self.view = MouseView(client)
        box.append(self.view)
        self.log = EventLog(client)
        box.append(self.log)
        clear.connect("clicked", lambda *_a: self.log.clear())
        self.toast.set_child(box)
        tb.set_content(self.toast)
        self.set_content(tb)
        self.pin.connect("toggled", self._on_pin)
        if PREFS.get("live_pinned"):
            # The compositor needs the mapped window before it can pin it.
            GLib.timeout_add(500, lambda: self.pin.set_active(True) or False)

    def _on_pin(self, btn):
        if self._pin_guard:
            return
        on = btn.get_active()
        ok, msg = set_window_sticky(self.get_title() or "", on)
        if ok:
            PREFS["live_pinned"] = on
            try:
                save_ui_prefs(PREFS)
            except Exception:  # noqa: BLE001
                pass
            if on:
                self.toast.add_toast(Adw.Toast(title=_("Pinned: the window stays on screen while workspaces slide")))
            return
        self.toast.add_toast(Adw.Toast(title=msg, timeout=8))
        if on:
            self._pin_guard = True
            btn.set_active(False)
            self._pin_guard = False


