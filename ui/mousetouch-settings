def combo_row(title, subtitle, options, current, on_change, searchable=False):
    row = Adw.ComboRow(title=title, subtitle=subtitle or "")
    model = Gtk.StringList.new([label for _k, label in options])
    row.set_model(model)
    if searchable:
        row.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
        row.set_enable_search(True)
    keys = [k for k, _l in options]
    row.set_selected(keys.index(current) if current in keys else 0)
    row.connect("notify::selected", lambda r, _p: on_change(keys[r.get_selected()]))
    return row


def spin_row(title, subtitle, value, lo, hi, step, digits, on_change):
    adj = Gtk.Adjustment(value=value, lower=lo, upper=hi, step_increment=step, page_increment=step * 10)
    row = Adw.SpinRow(title=title, subtitle=subtitle or "", adjustment=adj, digits=digits)
    row.connect("notify::value", lambda r, _p: on_change(round(r.get_value(), digits) if digits else int(r.get_value())))
    return row


def switch_row(title, subtitle, value, on_change):
    row = Adw.SwitchRow(title=title, subtitle=subtitle or "")
    row.set_active(bool(value))
    row.connect("notify::active", lambda r, _p: on_change(r.get_active()))
    return row


class GestureDialog(Adw.Dialog):
    """Add or edit one discrete gesture rule."""

    def __init__(self, gesture: dict | None, on_done):
        super().__init__(title=_("Gesture"), content_width=420)
        self.g = dict(gesture) if gesture else {"kind": "tap", "fingers": 3, "enabled": True, "action": {"type": "key", "combo": ""}}
        self.g["action"] = dict(self.g["action"])
        self.on_done = on_done

        tb = Adw.ToolbarView()
        header = Adw.HeaderBar()
        cancel = Gtk.Button(label=_("Cancel"))
        cancel.connect("clicked", lambda *_a: self.close())
        save = Gtk.Button(label=_("Save"), css_classes=["suggested-action"])
        save.connect("clicked", self._save)
        header.pack_start(cancel)
        header.pack_end(save)
        header.set_show_end_title_buttons(False)
        header.set_show_start_title_buttons(False)
        tb.add_top_bar(header)

        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup(title=_("Trigger"))
        grp.add(combo_row(_("Type"), None, KINDS(), self.g["kind"], self._set_kind))
        grp.add(spin_row(_("Fingers"), None, int(self.g["fingers"]), 1, 5, 1, 0, lambda v: self.g.__setitem__("fingers", v)))
        self.dir_row = combo_row(_("Direction"), _("Only for swipes"), DIRS(), self.g.get("direction") or "left",
                                 lambda v: self.g.__setitem__("direction", v))
        self.dir_row.set_visible(self.g["kind"] == "swipe")
        grp.add(self.dir_row)
        page.add(grp)

        grp = Adw.PreferencesGroup(title=_("Action"))
        grp.add(combo_row(_("Do"), None, ACTIONS(), self.g["action"]["type"], self._set_action_type))
        self.value_row = Adw.EntryRow(title=ACTION_HINT(self.g["action"]["type"]))
        self.value_row.set_text(self._action_value())
        grp.add(self.value_row)
        self.off_row = Adw.EntryRow(title=_("Second trigger (off), e.g. ctrl+0"))
        self.off_row.set_text(self.g["action"].get("off", ""))
        self.off_row.set_visible(self.g["action"]["type"] == "toggle")
        grp.add(self.off_row)
        page.add(grp)

        grp = Adw.PreferencesGroup(title=_("Scope"),
                                   description=_("Leave empty for every app. Otherwise the rule only fires when the focused window's app id contains this text (e.g. firefox). Needs COSMIC, KDE, Sway or Hyprland."))
        self.app_row = Adw.EntryRow(title=_("Only in app"))
        self.app_row.set_text(self.g.get("app") or "")
        grp.add(self.app_row)
        page.add(grp)
        tb.set_content(page)
        self.set_child(tb)

    def _action_value(self):
        a = self.g["action"]
        if a.get("type") == "cycle":
            return " ; ".join(a.get("steps", []))
        return a.get("combo") or a.get("on") or a.get("button") or a.get("command") or ""

    def _set_kind(self, k):
        self.g["kind"] = k
        self.dir_row.set_visible(k == "swipe")
        if k == "swipe" and not self.g.get("direction"):
            self.g["direction"] = "left"

    def _set_action_type(self, t):
        self.g["action"] = {"type": t}
        self.value_row.set_title(ACTION_HINT(t))
        self.off_row.set_visible(t == "toggle")

    def _save(self, *_a):
        t = self.g["action"]["type"]
        key = {"key": "combo", "toggle": "on", "cycle": "steps", "button": "button", "command": "command"}[t]
        value = self.value_row.get_text().strip()
        if not value:
            self.value_row.add_css_class("error")
            return
        if t == "cycle":
            value = [p.strip() for p in value.split(";") if p.strip()]
        self.g["action"] = {"type": t, key: value}
        if t == "toggle":
            off = self.off_row.get_text().strip()
            if not off:
                self.off_row.add_css_class("error")
                return
            self.g["action"]["off"] = off
        if self.g["kind"] != "swipe":
            self.g.pop("direction", None)
        app = self.app_row.get_text().strip()
        if app:
            self.g["app"] = app
        else:
            self.g.pop("app", None)
        self.on_done(self.g)
        self.close()


# ---------------------------------------------------------------------------
# Live view. The daemon grabs the mouse, so it is the only thing that can see
# the fingers; it republishes them on $XDG_RUNTIME_DIR/mousetouch.sock as
# JSON lines (see src/monitor.rs). One EventClient feeds every view.
# ---------------------------------------------------------------------------

def socket_path() -> Path:
    run = os.environ.get("XDG_RUNTIME_DIR")
    if run and os.path.isabs(run):
        return Path(run) / "mousetouch.sock"
    return Path(f"/tmp/mousetouch-{os.getuid()}.sock")


class EventClient:
    """Connection to the daemon's event stream; retries every 1.5 s while the
    daemon is away. Listeners get each decoded event plus synthetic
    {"t": "connected"} / {"t": "disconnected"} markers."""

    def __init__(self):
        self.listeners = []
        self.connected = False
        self._sock = None
        self._buf = b""
        GLib.timeout_add(1500, self._try_connect)
        self._try_connect()

    def add_listener(self, fn):
        if fn not in self.listeners:
            self.listeners.append(fn)

    def remove_listener(self, fn):
        if fn in self.listeners:
            self.listeners.remove(fn)

    def _emit(self, ev):
        for fn in list(self.listeners):
            fn(ev)

    def _try_connect(self):
        if self._sock is not None:
            return True
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.setblocking(False)
        try:
            s.connect(str(socket_path()))
        except OSError:
            s.close()
            return True
        self._sock = s
        self.connected = True
        GLib.io_add_watch(s.fileno(), GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._on_readable)
        self._emit({"t": "connected"})
        return True

    def _on_readable(self, _fd, cond):
        data = b""
        if cond & GLib.IO_IN:
            try:
                data = self._sock.recv(65536)
            except BlockingIOError:
                return True
            except OSError:
                data = b""
        if not data:
            self._sock.close()
            self._sock = None
            self._buf = b""
            self.connected = False
            self._emit({"t": "disconnected"})
            return False
        self._buf += data
        *lines, self._buf = self._buf.split(b"\n")
        for ln in lines:
            if ln:
                try:
                    self._emit(json.loads(ln))
                except ValueError:
                    pass
        return True


