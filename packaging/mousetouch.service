[Unit]
Description=MouseTouch: Magic Mouse gestures daemon (userspace driver)
Documentation=https://github.com/Devace-93/mousetouch
# Keep running across desktop sessions; the virtual devices are seat-wide.

[Service]
Type=simple
ExecStart=/usr/bin/env mousetouch run
Restart=on-failure
RestartSec=2
Nice=-5

[Install]
WantedBy=default.target
