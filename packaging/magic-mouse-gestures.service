[Unit]
Description=Magic Mouse gestures daemon (userspace driver)
Documentation=https://github.com/Devace-93/magic-mouse-gestures
# Keep running across desktop sessions; the virtual devices are seat-wide.

[Service]
Type=simple
ExecStart=/usr/bin/env magic-mouse-gestures run
Restart=on-failure
RestartSec=2
Nice=-5

[Install]
WantedBy=default.target
